# Copier en .env (jamais commité). Toutes ces valeurs sont PUBLIQUES :
# les variables EXPO_PUBLIC_* sont intégrées en clair dans l'application.
# N'y mettez jamais de secret serveur.

# Clés SDK publiques RevenueCat (Project settings > API keys)
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# Contact envoyé dans le User-Agent demandé par Open Food Facts
EXPO_PUBLIC_CONTACT_EMAIL=

# Pages publiques (https obligatoire)
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
